# Copy this file to ".env" in this same folder and fill in your own values.
# ".env" is already in .gitignore -- never commit your real private key.

# ---- Safety switches (read these twice) -----------------------------------

# "testnet" or "mainnet". ALWAYS start on testnet.
HL_NETWORK=testnet

# true  -> no real orders are ever sent, everything is simulated (paper
#          trading). This is the default and the only mode that should run
#          unattended without you watching it.
# false -> LIVE trading. Requires HYPERLIQUID_PRIVATE_KEY below, and `cli.py
#          start` will also refuse to run live without the
#          --yes-i-understand-live-trading flag on top of this.
DRY_RUN=true

# ---- Credentials (only required when DRY_RUN=false) -----------------------

# Your wallet's private key, hex-encoded with a 0x prefix (66 chars total).
# Strongly recommended: use a Hyperliquid "API wallet" / agent wallet
# generated from the Hyperliquid app (Settings -> API), NOT your main
# wallet's key, and only fund it with the small amount you intend to trade.
# NEVER share this key or commit it anywhere.
HYPERLIQUID_PRIVATE_KEY=

# Optional: set this if HYPERLIQUID_PRIVATE_KEY is an API/agent wallet that
# trades on behalf of a different main account address. Leave blank to use
# the address derived from the private key itself.
HYPERLIQUID_ACCOUNT_ADDRESS=

# ---- Misc -----------------------------------------------------------------

# DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# Where strategy/risk parameters live (see config/settings.yaml).
STRATEGY_CONFIG_PATH=config/settings.yaml

# Where runtime state (state.json, control.cmd, bot.pid) is written.
BOT_STATE_DIR=runtime
