# Copia este archivo como ".env" (sin ".example") y pon tus valores.
# Nunca subas el archivo ".env" real a GitHub — por eso está en .gitignore.

# --- Obligatorio: el cerebro ------------------------------------------------
# Clave GRATIS de Groq: crea cuenta en https://console.groq.com/keys (sin tarjeta).
GROQ_API_KEY=

# Opcional: cambia el modelo si quieres (por defecto usa uno gratuito potente).
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL_RESPALDO=openai/gpt-oss-20b

# Nombre con el que la IA se dirige a ti.
JARVIS_USUARIA=Daniela

# Nombre con el que la IA se identifica y palabra que hay que decir para
# activarla por voz (por defecto "Luna"). Cámbialo si quieres otro nombre.
# JARVIS_NOMBRE_ASISTENTE=Luna

# --- Opcional: mejor voz y mejor oído con ElevenLabs ------------------------
# Si los dejas vacíos, usa reconocimiento y voz gratis sin límite.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Opcional: ajustes finos -------------------------------------------------
# JARVIS_PUERTO=8790
# JARVIS_IDIOMA=es-CO
# JARVIS_INPUT_DEVICE=

# El piso de ruido para detectar tu voz se calibra solo al iniciar (mide el
# ruido de fondo de tu cuarto). Si aun así casi no te escucha, baja estos dos
# números (más bajo = más sensible):
# JARVIS_UMBRAL_VOZ=0.0025         # piso mínimo absoluto (súbelo si detecta ruido como voz)
# JARVIS_SPIKE_RATIO_VOZ=2.0       # qué tan por encima del ruido de fondo debe estar tu voz

# Cuánto texto puede generar como máximo en cada respuesta. Si sientes que las
# respuestas quedan cortas/limitadas, súbelo (hasta 65536 en los modelos por
# defecto).
# JARVIS_MAX_TOKENS_RESPUESTA=4096

# Voz neuronal gratis (Edge TTS) que usa por defecto para responder.
# Cambia el acento/género si quieres; lista completa con: edge-tts --list-voices
# JARVIS_VOZ_EDGE=es-CO-SalomeNeural

# Ciudad que muestra el widget de clima del dashboard.
# JARVIS_CIUDAD_CLIMA=Buga, Colombia
