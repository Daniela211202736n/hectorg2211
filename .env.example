# Copia este archivo como ".env" (sin ".example") y pon tus valores.
# Nunca subas el archivo ".env" real a GitHub — por eso está en .gitignore.

# --- Obligatorio: el cerebro ------------------------------------------------
# Clave GRATIS de Groq: crea cuenta en https://console.groq.com/keys (sin tarjeta).
GROQ_API_KEY=

# Opcional: cambia el modelo si quieres (por defecto usa uno gratuito potente).
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MODEL_RESPALDO=llama-3.1-8b-instant

# Nombre con el que Jarvis se dirige a ti.
JARVIS_USUARIA=Daniela

# --- Opcional: mejor voz y mejor oído con ElevenLabs ------------------------
# Si los dejas vacíos, Jarvis usa reconocimiento y voz gratis sin límite.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Opcional: ajustes finos -------------------------------------------------
# JARVIS_PUERTO=8790
# JARVIS_IDIOMA=es-CO
# JARVIS_UMBRAL_VOZ=0.015
# JARVIS_INPUT_DEVICE=

# Voz neuronal gratis (Edge TTS) que usa Jarvis por defecto para responder.
# Cambia el acento/género si quieres; lista completa con: edge-tts --list-voices
# JARVIS_VOZ_EDGE=es-CO-SalomeNeural
